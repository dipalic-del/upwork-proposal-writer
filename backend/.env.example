# Supabase Configuration
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Optional: Direct PostgreSQL URI (found in Project Settings -> Database)
# e.g., postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Hugging Face Configuration (Free Serverless Inference API)
# Get a free read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Model settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_GENERATION_MODEL=Qwen/Qwen2.5-72B-Instruct

# Server settings
PORT=8000
HOST=0.0.0.0

